[Unit]
Description=Fetch the HugOli test site from GitHub
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=hugoli-deploy
Group=hugoli-deploy
Environment=LC_ALL=C
Environment=GIT_TERMINAL_PROMPT=0
ExecStart=/usr/bin/python3 /opt/hugoli-deploy/pull.py
TimeoutStartSec=90
UMask=0022
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/hugoli-deploy /var/www/hugoli/test
